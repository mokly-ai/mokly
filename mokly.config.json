{
  "$schema": "./node_modules/@mokly/mokly/config.schema.json",
  "repoRoot": ".",
  "roots": [
    { "dir": "docs/mockups/src/entries", "files": ["**/*.mockup.{ts,tsx}"] }
  ],
  "renderer": "docs/mockups/src/render.tsx",
  "colorSchemes": ["light", "dark"],
  "moduleResolution": {
    "aliases": { "react-native": "react-native-web" },
    "conditions": ["react-native", "import", "module", "default"],
    "loaders": { ".js": "jsx" },
    "mainFields": ["react-native", "module", "main"],
    "packageRoots": ["."],
    "resolveExtensions": [
      ".web.tsx",
      ".web.ts",
      ".web.js",
      ".tsx",
      ".ts",
      ".jsx",
      ".js",
      ".json"
    ]
  },
  "stylesheets": [
    {
      "match": "design/site/**/index.html",
      "stylesheets": [
        "docs/mockups/styles/fonts/geist.css",
        "docs/mockups/styles/site/fonts/instrument-serif.css",
        "docs/mockups/styles/site/base.css",
        "docs/mockups/styles/site/buttons.css",
        "docs/mockups/styles/site/canvas.css",
        "docs/mockups/styles/site/canvas-tags.css",
        "docs/mockups/styles/site/labels.css",
        "docs/mockups/styles/site/people.css",
        "docs/mockups/styles/site/panels.css",
        "docs/mockups/styles/site/code.css",
        "docs/mockups/styles/site/prose.css",
        "docs/mockups/styles/site/chrome.css",
        "docs/mockups/styles/site/menu.css",
        "docs/mockups/styles/site/footer.css",
        "docs/mockups/styles/site/policy.css",
        "docs/mockups/styles/site/home.css",
        "docs/mockups/styles/site/home-hero.css",
        "docs/mockups/styles/site/home-spread.css",
        "docs/mockups/styles/site/home-acme.css",
        "docs/mockups/styles/site/home-acme-screens.css",
        "docs/mockups/styles/site/home-acme-parts.css",
        "docs/mockups/styles/site/home-acme-checkout.css",
        "docs/mockups/styles/site/home-acme-pricing.css",
        "docs/mockups/styles/site/home-acme-spread.css",
        "docs/mockups/styles/site/shell-frame.css",
        "docs/mockups/styles/site/shell-tree.css",
        "docs/mockups/styles/site/shell-stage.css",
        "docs/mockups/styles/site/home-browse.css",
        "docs/mockups/styles/site/modules.css",
        "docs/mockups/styles/site/home-review.css",
        "docs/mockups/styles/site/home-edit.css",
        "docs/mockups/styles/site/home-foundation.css",
        "docs/mockups/styles/site/closing.css",
        "docs/mockups/styles/site/home-responsive.css",
        "docs/mockups/styles/site/docs-tree.css",
        "docs/mockups/styles/site/docs-document.css",
        "docs/mockups/styles/site/docs-inspect.css",
        "docs/mockups/styles/site/docs-sample.css",
        "docs/mockups/styles/site/docs-sample-frames.css",
        "docs/mockups/styles/site/docs-responsive.css",
        "docs/mockups/styles/site/docs-steps.css",
        "docs/mockups/styles/site/changelog.css",
        "docs/mockups/styles/site/changelog-timeline.css",
        "docs/mockups/styles/site/changelog-notes.css",
        "docs/mockups/styles/site/changelog-release.css",
        "docs/mockups/styles/site/changelog-earlier.css",
        "docs/mockups/styles/site/changelog-responsive.css",
        "docs/mockups/styles/site/pricing.css",
        "docs/mockups/styles/site/pricing-plans.css",
        "docs/mockups/styles/site/pricing-compare.css",
        "docs/mockups/styles/site/pricing-responsive.css",
        "docs/mockups/styles/site/download.css",
        "docs/mockups/styles/site/download-responsive.css"
      ]
    },
    {
      "match": "design/email/**/index.html",
      "stylesheets": [
        "docs/mockups/styles/base.css",
        "docs/mockups/styles/email/frame.css"
      ]
    },
    {
      "match": "product/{account,recovery,settings,viewer}/**/index.html",
      "stylesheets": [
        "docs/mockups/styles/base.css",
        "docs/mockups/styles/components.css",
        "docs/mockups/styles/controls.css",
        "docs/mockups/styles/product/shared.css",
        "docs/mockups/styles/product/chrome.css",
        "docs/mockups/styles/product/folio.css",
        "docs/mockups/styles/product/inventory.css"
      ]
    },
    {
      "match": "**/*.html",
      "stylesheets": [
        "docs/mockups/styles/base.css",
        "docs/mockups/styles/components.css",
        "docs/mockups/styles/illustrations/illustration.css",
        "docs/mockups/styles/controls.css"
      ]
    }
  ],
  "review": { "base": "origin/main" }
}
