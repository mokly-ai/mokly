{
  "repoRoot": ".",
  "roots": [
    {
      "dir": "catalogue/src/entries",
      "files": [
        "**/*.screen.html",
        "**/*.component.html",
        "**/*.page.html",
        "**/*.use-case.yaml",
        "**/*.md"
      ]
