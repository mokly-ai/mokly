---
import Policy from "../components/Policy.astro";
import Site from "../layouts/Site.astro";
import { PAGE_METADATA } from "../metadata.js";
import { SITE_PATHS } from "../navigation.js";

import "../styles/document.css";

const { description, title } = PAGE_METADATA[SITE_PATHS.terms];
---

<Site
  description={description}
  main="site-document site-policy"
  route={SITE_PATHS.terms}
  title={title}
>
  <Policy id="terms" />
</Site>
