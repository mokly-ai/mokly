---
import Site from "../layouts/Site.astro";
import { NOT_FOUND_ROUTE, PAGE_METADATA } from "../metadata.js";

const { description, title } = PAGE_METADATA[NOT_FOUND_ROUTE];
---

<Site
  description={description}
  indexed={false}
  main="site-document site-policy"
  route={NOT_FOUND_ROUTE}
  title={title}
>
  <div class="site-document-intro">
    <h1>Page not found</h1>
  </div>
</Site>
