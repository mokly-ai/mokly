---
/**
 * The "On this page" list, generated from the page's own second and third
 * level headings. A page with fewer than two of them renders nothing.
 */
import type { DocsHeading } from "../../docs/headings.js";

interface Props {
  readonly headings: readonly DocsHeading[];
}

const { headings } = Astro.props;
---

{headings.length > 1 && (
  <nav aria-label="On this page" class="site-onpage" data-pagefind-ignore>
    <p class="site-rubric">On this page</p>
    <ol>
      {headings.map((heading) => (
        <li>
          <a
            class:list={[
              "site-onpage-link",
              heading.depth > 2 && "site-onpage-link--nested",
            ]}
            href={`#${heading.slug}`}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
