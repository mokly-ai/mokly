---
/**
 * One decorative line glyph from the shared set. Glyphs never carry meaning
 * of their own; the label beside them names what the row or control is.
 */
import { GLYPHS, GLYPH_SIZES, type GlyphName } from "../glyphs.js";

interface Props {
  readonly name: GlyphName;
  readonly size?: number;
}

const { name, size = GLYPH_SIZES[Astro.props.name] } = Astro.props;
---

<svg
  aria-hidden="true"
  fill="none"
  height={size}
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="2"
  viewBox="0 0 24 24"
  width={size}
  set:html={GLYPHS[name]}
/>
