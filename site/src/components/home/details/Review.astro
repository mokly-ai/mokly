---
/**
 * The Review detail: a comment pinned to a screen beside the comment itself
 * and its Approve control, redrawn from the tokens.
 */
---

<div aria-hidden="true" class="site-detail site-detail--split">
  <div class="site-detail-screen">
    <span class="site-detail-bar site-detail-bar--wide"></span>
    <span class="site-detail-block"></span>
    <span class="site-detail-bar"></span>
    <span class="site-pin">1</span>
  </div>
  <div class="site-comment">
    <p class="site-comment-head">
      <span class="site-pin site-pin--inline">1</span>Comment
    </p>
    <span class="site-detail-bar site-detail-bar--wide"></span>
    <span class="site-detail-bar"></span>
    <span class="site-comment-approve">Approve</span>
  </div>
</div>
