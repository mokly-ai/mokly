---
/**
 * The home hero: the eyebrow, the two-line heading whose second line takes
 * the accent, the lead, both actions and the note under them. The copy is the
 * approved home copy in docs/protocol/site.md.
 */
import Actions from "./Actions.astro";
---

<section class="site-hero">
  <p class="site-hero-eyebrow">A design tool for teams that ship</p>
  <h1>
    Design in your repository.
    <br /> <span class="site-accent">Decide in the pull request.</span>
  </h1>
  <p class="site-hero-lead">
    Your mockups are React components in Git. Browse every branch as screens,
    review them with your team, and edit with an agent beside the screen.
  </p>
  <Actions />
  <p class="site-hero-note">Light and dark. Mobile and desktop.</p>
</section>
