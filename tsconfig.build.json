{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/_tests_/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ]
}
