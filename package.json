{
  "name": "@mokly/mokly",
  "version": "0.9.0",
  "description": "App-independent static mockup catalogues, development browsing, and on-demand visual comparisons.",
  "type": "module",
  "license": "MIT",
  "author": "Mokly",
  "homepage": "https://github.com/mokly-ai/mokly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokly-ai/mokly.git"
  },
  "bugs": {
    "url": "https://github.com/mokly-ai/mokly/issues"
  },
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "mokly": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/protocol",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run build --workspace @mokly/viewer && tsc --project tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "dependencies:check": "npm audit --audit-level=low --include=prod --include=dev --include=optional --include=peer",
    "dev": "npm run build && node dist/cli/bin.js serve --config examples/basic/mokly.config.ts",
    "dev:large": "node scripts/large/cli.mjs serve",
    "fixture:large": "npm run build && tsx scripts/large/cli.mjs generate",
    "benchmark:large": "node scripts/large/cli.mjs benchmark",
    "example:build": "node dist/cli/bin.js build --config examples/basic/mokly.config.ts",
    "example:check": "node dist/cli/bin.js check --config examples/basic/mokly.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "node scripts/package-check.mjs",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "preview:build": "npm run build && npm run example:build && node scripts/preview/build.mjs",
    "test": "npm run build && npm run example:build && tsx --test --test-concurrency=2 tests/**/*.test.ts tests/**/*.test.tsx packages/viewer/tests/*.test.ts packages/viewer/tests/*.test.tsx",
    "test:browser": "npm run build && npm run example:build && playwright test",
    "typecheck": "npm run build && tsc --project tsconfig.json --noEmit && npm run typecheck --workspace @mokly/viewer"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "css-select": "^7.0.0",
    "css-what": "^8.0.0",
    "esbuild": "^0.28.1",
    "koffi": "^3.2.1",
    "lightningcss": "^1.33.0",
    "minimatch": "^10.2.6",
    "parse5": "^8.0.1",
    "tar": "^7.5.22",
    "tar-stream": "^3.2.1",
    "@mokly/viewer": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firna/ui": "^0.14.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "lucide-react-native": "^0.577.0",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "4.113.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "workspaces": [
    "packages/viewer"
  ]
}
