{
  "name": "mokly-workspace",
  "version": "0.14.0",
  "description": "App-independent static mockup catalogues, development browsing, and on-demand visual comparisons.",
  "type": "module",
  "license": "MIT",
  "author": "Mokly",
  "homepage": "https://github.com/mokly-ai/mokly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokly-ai/mokly.git"
  },
  "bugs": {
    "url": "https://github.com/mokly-ai/mokly/issues"
  },
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.14.0 <24.14.0 || >=24.19.0"
  },
  "scripts": {
    "build": "cargo xtask build-native && npm run -s build --workspace @mokly/viewer && npm run -s build --workspace @mokly/mokly",
    "clean": "node scripts/clean.mjs",
    "dependencies:check": "node scripts/verification/dependency-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run -s build && node scripts/verification/run-viewer.mjs",
    "test:prepared": "node scripts/verification/run-viewer.mjs --strict",
    "test:viewer:prepared": "node scripts/verification/run-viewer.mjs --strict",
    "typecheck": "tsc --project packages/mokly/tsconfig.json --noEmit && tsc --project tsconfig.json --noEmit && npm run typecheck --workspace @mokly/viewer && npm run typecheck:script-declarations",
    "typecheck:script-declarations": "tsc --project tsconfig.scripts-declarations.json --noEmit",
    "dev": "node packages/mokly/bin/mokly.mjs serve --config examples/basic/mokly.config.json",
    "test:browser": "npm run -s build && node scripts/verification/browser-developer.mjs",
    "test:browser:prepared": "node scripts/verification/run-browser.mjs"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@eslint/js": "^10.0.1",
    "@firna/ui": "^0.14.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mokly/viewer": "0.5.0",
    "@playwright/test": "^1.61.1",
    "@storybook/react": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "lightningcss": "^1.33.0",
    "lucide-react-native": "^0.577.0",
    "marked": "^18.1.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-reanimated": "~4.3.4",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.8.3",
    "release-please": "17.6.0",
    "semver": "^7.7.3",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "4.151.0",
    "yaml": "^2.9.1"
  },
  "workspaces": [
    "packages/viewer",
    "packages/mokly"
  ],
  "private": true,
  "optionalDependencies": {
    "@mokly/native-darwin-arm64": "file:packages/native-darwin-arm64",
    "@mokly/native-darwin-x64": "file:packages/native-darwin-x64",
    "@mokly/native-linux-arm64-gnu": "file:packages/native-linux-arm64-gnu",
    "@mokly/native-linux-x64-gnu": "file:packages/native-linux-x64-gnu",
    "@mokly/native-win32-x64-msvc": "file:packages/native-win32-x64-msvc"
  }
}
