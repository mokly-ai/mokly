{
  "name": "mokly-workspace",
  "version": "0.21.0",
  "description": "App-independent static mockup catalogues, development browsing, and on-demand visual comparisons.",
  "type": "module",
  "license": "MIT",
  "author": "Mokly",
  "homepage": "https://github.com/mokly-ai/mokly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokly-ai/mokly.git"
  },
  "bugs": {
    "url": "https://github.com/mokly-ai/mokly/issues"
  },
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.15.0 <23.0.0 || >=24.0.0 <24.14.0 || >=24.19.0"
  },
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "clean": "node scripts/clean.mjs",
    "ci:refresh-shard-weights": "node scripts/verification/refresh-shard-weights.mjs",
    "dependencies:check": "node scripts/verification/dependency-audit.mjs",
    "dependencies:check:rust": "node scripts/verification/audit-rust.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:smoke": "npm run -s build && node --import tsx scripts/release/smoke_example.mjs",
    "palette:check": "npm run palette:check --workspace @mokly/ui",
    "palette:generate": "npm run palette:generate --workspace @mokly/ui",
    "test": "npm run -s build && node scripts/verification/run-viewer.mjs",
    "test:prepared": "node scripts/verification/run-viewer.mjs --strict",
    "test:viewer:prepared": "node scripts/verification/run-viewer.mjs --strict",
    "typecheck": "node scripts/verification/typecheck.mjs",
    "typecheck:ci": "node scripts/verification/typecheck.mjs --ci",
    "typecheck:fast": "node scripts/verification/typecheck.mjs --fast",
    "typecheck:script-declarations": "tsc --project tsconfig.scripts-declarations.json --noEmit",
    "dev": "node scripts/dev.mjs serve --config examples/basic/mokly.config.json",
    "fixture:large": "node --import tsx scripts/large/cli.ts generate",
    "benchmark:large": "node --import tsx scripts/large/cli.ts benchmark",
    "test:browser": "npm run -s build && node scripts/verification/browser-developer.mjs",
    "test:browser:prepared": "node scripts/verification/run-browser.mjs",
    "test:delivery:prepared": "node scripts/verification/static-delivery.mjs",
    "mockups:build": "npm run mockups:build --workspace @mokly-cloud/mockups",
    "mockups:check": "npm run mockups:check --workspace @mokly-cloud/mockups",
    "mockups:test": "npm run mockups:test --workspace @mokly-cloud/mockups",
    "mockups:typecheck": "npm run mockups:typecheck --workspace @mokly-cloud/mockups",
    "mockups:serve": "npm run mockups:serve --workspace @mokly-cloud/mockups",
    "emails:build": "npm run emails:build --workspace @mokly-cloud/mockups",
    "emails:check": "npm run emails:check --workspace @mokly-cloud/mockups",
    "emails:test": "npm run emails:test --workspace @mokly-cloud/mockups",
    "site:browser": "npm run browser --workspace @mokly-cloud/site",
    "site:build": "npm run build --workspace @mokly-cloud/site",
    "site:check": "npm run site:build && npm run site:typecheck && npm run site:test && npm run site:links && npm run site:browser",
    "site:lighthouse": "npm run lighthouse --workspace @mokly-cloud/site",
    "site:links": "npm run links --workspace @mokly-cloud/site",
    "site:routes": "npm run routes:generate --workspace @mokly-cloud/site",
    "site:test": "npm run test --workspace @mokly-cloud/site",
    "site:typecheck": "npm run typecheck --workspace @mokly-cloud/site",
    "cloud:typecheck": "npm run typecheck --workspace packages/tokens --workspace packages/app --workspace packages/desktop --workspace apps/mockups --workspace apps/site --workspace apps/worker",
    "cloud:test": "npm run test --if-present --workspace packages/tokens --workspace packages/app --workspace packages/desktop --workspace apps/mockups --workspace apps/site --workspace apps/worker"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@eslint/js": "^10.0.1",
    "@firna/ui": "4.0.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@happy-dom/global-registrator": "^21.0.4",
    "@mokly/frame": "0.21.0",
    "@mokly/model": "0.21.0",
    "@mokly/ui": "0.21.0",
    "@mokly/viewer": "0.21.0",
    "@playwright/test": "^1.61.1",
    "@storybook/react": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "@yarnpkg/cli-dist": "4.18.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "lucide-react": "^0.577.0",
    "lucide-react-native": "^0.577.0",
    "marked": "^18.1.0",
    "parse5": "^8.0.1",
    "pnpm": "10.34.7",
    "pnpm-modern": "npm:pnpm@11.20.0",
    "pnpm-native": "npm:pnpm@12.14.0",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-reanimated": "~4.3.4",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "~15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.8.3",
    "release-please": "17.6.0",
    "semver": "^7.7.3",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "tar": "7.5.22",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "4.164.0",
    "yaml": "^2.9.1",
    "yarn": "1.22.22"
  },
  "overrides": {
    "@google-automations/git-file-utils": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "code-suggester": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    }
  },
  "workspaces": [
    "packages/ui",
    "packages/model",
    "packages/frame",
    "packages/viewer",
    "packages/mokly",
    "packages/tokens",
    "packages/app",
    "packages/desktop",
    "apps/mockups",
    "apps/site",
    "apps/worker"
  ],
  "private": true,
  "optionalDependencies": {
    "@mokly/native-darwin-arm64": "file:packages/native-darwin-arm64",
    "@mokly/native-darwin-x64": "file:packages/native-darwin-x64",
    "@mokly/native-linux-arm64-gnu": "file:packages/native-linux-arm64-gnu",
    "@mokly/native-linux-x64-gnu": "file:packages/native-linux-x64-gnu",
    "@mokly/native-win32-x64-msvc": "file:packages/native-win32-x64-msvc"
  }
}
