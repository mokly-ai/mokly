{
  "name": "@mokly/mokly",
  "version": "0.13.0",
  "description": "App-independent static mockup catalogues, development browsing, and on-demand visual comparisons.",
  "type": "module",
  "license": "MIT",
  "author": "Mokly",
  "homepage": "https://github.com/mokly-ai/mokly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokly-ai/mokly.git"
  },
  "bugs": {
    "url": "https://github.com/mokly-ai/mokly/issues"
  },
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.14.0 <24.14.0 || >=24.19.0"
  },
  "bin": {
    "mokly": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/guides",
    "docs/protocol",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run -s build --workspace @mokly/viewer && tsc --project tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "dependencies:check": "node scripts/verification/dependency-audit.mjs",
    "dev": "npm run -s build && node dist/cli/bin.js serve --config examples/basic/mokly.config.ts",
    "dev:large": "node scripts/large/cli.mjs serve",
    "fixture:large": "npm run build && tsx scripts/large/cli.mjs generate",
    "benchmark:large": "node scripts/large/cli.mjs benchmark",
    "example:build": "node dist/cli/bin.js build --config examples/basic/mokly.config.ts",
    "example:check": "node dist/cli/bin.js check --config examples/basic/mokly.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:artifacts": "node scripts/package-artifacts.mjs",
    "package:check": "npm run build && npm run package:check:prepared --",
    "package:check:prepared": "node scripts/verification/prepared.mjs package && node scripts/package-check.mjs",
    "package:smoke": "npm run build && npm run package:smoke:prepared --",
    "package:smoke:prepared": "node scripts/verification/prepared.mjs package && node scripts/package-smoke.mjs",
    "prepare:verification": "npm run build && npm run example:build",
    "prepack": "npm run build",
    "preview:build": "npm run build && npm run example:build && node scripts/preview/build.mjs",
    "test": "npm run prepare:verification && node scripts/verification/run-unit-dev.mjs",
    "test:browser": "npm run prepare:verification && playwright test",
    "test:browser:prepared": "node scripts/verification/run-browser.mjs",
    "test:hydration:prepared": "node scripts/verification/run-browser.mjs --suite hydration",
    "test:prepared": "node scripts/verification/run-unit.mjs",
    "typecheck": "npm run build && npm run typecheck:prepared",
    "typecheck:prepared": "node scripts/verification/prepared.mjs package && tsc --project tsconfig.json --noEmit && npm run typecheck --workspace @mokly/viewer && npm run typecheck:script-declarations",
    "typecheck:script-declarations": "tsc --project tsconfig.scripts-declarations.json --noEmit"
  },
  "dependencies": {
    "@mokly/viewer": "0.4.0",
    "chokidar": "^5.0.0",
    "css-select": "^7.0.0",
    "css-what": "^8.0.0",
    "es-module-lexer": "^3.0.3",
    "esbuild": "^0.28.2",
    "icss-utils": "^5.1.0",
    "koffi": "^3.3.2",
    "lightningcss": "^1.33.0",
    "marked": "^18.1.0",
    "minimatch": "^10.2.6",
    "parse5": "^8.0.1",
    "postcss": "^8.5.29",
    "postcss-modules-extract-imports": "^3.1.0",
    "postcss-modules-local-by-default": "^4.2.0",
    "postcss-modules-scope": "^3.2.1",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "tar": "^7.5.22",
    "tar-stream": "^3.2.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firna/ui": "^0.14.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "lucide-react-native": "^0.577.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-reanimated": "~4.3.4",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "4.113.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "workspaces": [
    "packages/viewer"
  ]
}
