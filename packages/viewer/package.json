{
  "name": "@mokly/viewer",
  "version": "0.6.0",
  "description": "Embeddable Mokly catalogue viewer, frame adapters, and the client-rendered Browse shell.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/browser.js",
    "./dist/styles.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokly-ai/mokly.git",
    "directory": "packages/viewer"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "prepack": "npm run build"
  }
}
