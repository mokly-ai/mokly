{
  "name": "@mokly-cloud/app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "sync:styles": "node scripts/sync-styles.mjs",
    "start": "npm run build:web && node scripts/serve-dist.mjs",
    "build:web": "node scripts/build-web.mjs",
    "verify:web": "node scripts/verify-web-build.mjs",
    "api:generate": "openapi-typescript ../../docs/api/openapi.json -o src/api/generated/schema.ts",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "test": "npm run test:logic && npm run build:web && npm run test:browser",
    "test:logic": "node --test scripts/*.test.mjs && tsx --tsconfig tsconfig.runtime.json --import ./src/_tests_/register-web.mjs --test \"src/_tests_/**/*.test.ts\"",
    "test:browser": "playwright test --config playwright.config.ts --tsconfig tsconfig.runtime.json",
    "api:print": "openapi-typescript ../../docs/api/openapi.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "56.0.21",
    "@firna/ui": "4.0.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@mokly/viewer": "0.21.0",
    "expo": "56.0.21",
    "expo-constants": "56.0.25",
    "expo-linking": "56.0.17",
    "expo-router": "56.2.20",
    "expo-status-bar": "56.0.4",
    "lucide-react": "0.577.0",
    "lucide-react-native": "0.577.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.33.0",
    "react-native-reanimated": "4.3.4",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15"
  }
}
