{
  "expo": {
    "name": "Mokly",
    "slug": "mokly-cloud",
    "scheme": "mokly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "extra": { "router": { "sitemap": false } },
    "experiments": { "typedRoutes": false }
  }
}
