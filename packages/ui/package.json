{
  "name": "@mokly/ui",
  "version": "0.16.1",
  "description": "Presentational components and stylesheets of the Mokly Browse shell.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokly-ai/mokly.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "prepack": "npm run build"
  }
}
