{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "strict",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "ui": "stream",
  "cacheMaxAge": "14d",
  "globalPassThroughEnv": [
    "CI",
    "MOKLY_OUTPUT",
    "MOKLY_DIAGNOSTIC",
    "NO_COLOR",
    "FORCE_COLOR",
    "TERM",
    "TERM_PROGRAM",
    "WT_SESSION",
    "COLUMNS",
    "BROWSERSLIST_IGNORE_OLD_DATA"
  ],
  "futureFlags": {
    "longerSignatureKey": true
  },
  "remoteCache": {
    "enabled": true,
    "signature": true,
    "timeout": 30,
    "uploadTimeout": 60,
    "preflight": false,
    "apiUrl": "https://mokly-turbo-cache.calum-785.workers.dev",
    "teamSlug": "mokly"
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/scripts/clean.mjs"
      ],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "//#build:package": {
      "dependsOn": ["@mokly/viewer#build"],
      "inputs": [
        "src/**",
        "scripts/copy-assets.mjs",
        "scripts/clean.mjs",
        "tsconfig.json",
        "tsconfig.build.json",
        "!**/.context/**",
        "!**/.mokly-cache/**",
        "!**/.mokly-review-*/**",
        "!**/.mokly-write-*/**",
        "!**/.wrangler/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/dist/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/.superpowers/**",
        "!**/*.tgz"
      ],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "//#example:build": {
      "dependsOn": ["//#build:package"],
      "inputs": [
        "examples/basic/**",
        "examples/imported-assets/**",
        "!examples/basic/mokly-generated/**",
        "docs/protocol/mokly-component-controls-design.md",
        "docs/protocol/mokly-component-controls.md",
        "docs/protocol/mokly-component-design.md",
        "docs/protocol/mokly-component-explorer.md",
        "docs/protocol/mokly-component-inspector-design.md",
        "docs/protocol/mokly-component-workspace-design.md",
        "docs/protocol/mokly-design-component-library.md",
        "docs/protocol/mokly-design-components.md",
        "docs/protocol/mokly-shell-design.md",
        "docs/protocol/mokly-viewer-appearance.md",
        "!**/.context/**",
        "!**/.mokly-cache/**",
        "!**/.mokly-review-*/**",
        "!**/.mokly-write-*/**",
        "!**/.wrangler/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/dist/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/.superpowers/**",
        "!**/*.tgz"
      ],
      "outputs": ["examples/basic/mokly-generated/**"],
      "env": [
        "NODE_ENV",
        "BROWSERSLIST",
        "BROWSERSLIST_ENV",
        "AUTOPREFIXER_GRID"
      ]
    }
  }
}
