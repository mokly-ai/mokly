{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@mokly-cloud/tokens/*": ["../../packages/tokens/src/*.ts"],
      "@mokly/mokly": ["../../node_modules/@mokly/mokly/dist/index.d.ts"],
      "@mokly/viewer": ["../../node_modules/@mokly/viewer/dist/index.d.ts"],
      "@mokly/viewer/data": ["../../node_modules/@mokly/viewer/dist/data.d.ts"],
      "@mokly/ui/catalogue-navigation": [
        "../../node_modules/@mokly/ui/dist/catalogue-navigation/catalogue-navigation.d.ts"
      ],
      "@mokly/ui/catalogue-tree": [
        "../../node_modules/@mokly/ui/dist/catalogue-tree/catalogue-tree.d.ts"
      ],
      "@mokly/ui/change-status": [
        "../../node_modules/@mokly/ui/dist/change-status/change-status.d.ts"
      ],
      "@mokly/ui/comparison-stage": [
        "../../node_modules/@mokly/ui/dist/comparison-stage/comparison-stage.d.ts"
      ],
      "@mokly/ui/comparison-toolbar": [
        "../../node_modules/@mokly/ui/dist/comparison-toolbar/comparison-toolbar.d.ts"
      ],
      "@mokly/ui/device-frame": [
        "../../node_modules/@mokly/ui/dist/device-frame/device-frame.d.ts"
      ],
      "@mokly/ui/embedded-layout": [
        "../../node_modules/@mokly/ui/dist/embedded-layout/embedded-layout.d.ts"
      ],
      "@mokly/ui/preview-frame": [
        "../../node_modules/@mokly/ui/dist/preview-frame/preview-frame.d.ts"
      ],
      "@mokly/ui/screen-header": [
        "../../node_modules/@mokly/ui/dist/screen-header/screen-header.d.ts"
      ],
      "@mokly/ui/shell-layout": [
        "../../node_modules/@mokly/ui/dist/shell-layout/shell-layout.d.ts"
      ],
      "@mokly/ui/stage": ["../../node_modules/@mokly/ui/dist/stage/stage.d.ts"],
      "@mokly/ui/top-bar": [
        "../../node_modules/@mokly/ui/dist/top-bar/top-bar.d.ts"
      ],
      "@mokly/ui/view-controls": [
        "../../node_modules/@mokly/ui/dist/view-controls/view-controls.d.ts"
      ],
      "@mokly/ui/workspace-layout": [
        "../../node_modules/@mokly/ui/dist/workspace-layout/workspace-layout.d.ts"
      ],
      "react": ["../../node_modules/@types/react/index.d.ts"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"],
      "@playwright/test": ["../../node_modules/@playwright/test/index.d.ts"],
      "parse5": ["../../node_modules/parse5/dist/index.d.ts"],
      "typescript": ["../../node_modules/typescript/lib/typescript.d.ts"],
      "@firna/ui": ["./node_modules/@firna/ui/dist/node/index.d.ts"],
      "@firna/ui/theme": ["./node_modules/@firna/ui/dist/node/theme.d.ts"],
      "@firna/ui/*": ["./node_modules/@firna/ui/dist/node/*/index.d.ts"],
      "lucide-react-native": [
        "../../node_modules/lucide-react-native/dist/lucide-react-native.d.ts"
      ],
      "react-native": ["../../node_modules/react-native/types/index.d.ts"],
      "react-native-web": [
        "../../node_modules/@types/react-native-web/index.d.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "../../docs/mockups/src/**/*.ts",
    "../../docs/mockups/src/**/*.tsx",
    "playwright*.ts"
  ]
}
