        "../../node_modules/@mokly/ui/dist/canvas-dock/canvas-dock.d.ts"
      ],
      "@mokly/ui/canvas-frame": [
        "../../node_modules/@mokly/ui/dist/canvas-frame/canvas-frame.d.ts"
      ],
      "@mokly/ui/canvas-section": [
        "../../node_modules/@mokly/ui/dist/canvas-section/canvas-section.d.ts"
      ],
      "@mokly/ui/canvas-stage": [
        "../../node_modules/@mokly/ui/dist/canvas-stage/canvas-stage.d.ts"
      ],
      "@mokly/ui/catalogue-navigation": [
        "../../node_modules/@mokly/ui/dist/catalogue-navigation/catalogue-navigation.d.ts"
