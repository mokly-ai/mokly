        "../../node_modules/@mokly/ui/dist/compare-modes/compare-modes.d.ts"
      ],
      "@mokly/ui/embedded-layout": [
        "../../node_modules/@mokly/ui/dist/embedded-layout/embedded-layout.d.ts"
      ],
      "@mokly/ui/entry-bar": [
        "../../node_modules/@mokly/ui/dist/entry-bar/entry-bar.d.ts"
      ],
      "@mokly/ui/floating-panel": [
        "../../node_modules/@mokly/ui/dist/floating-panel/floating-panel.d.ts"
      ],
      "@mokly/ui/frames-filter": [
        "../../node_modules/@mokly/ui/dist/frames-filter/frames-filter.d.ts"
