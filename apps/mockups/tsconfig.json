      "@mokly/ui/panel-tabs": [
        "../../node_modules/@mokly/ui/dist/panel-tabs/panel-tabs.d.ts"
      ],
      "@mokly/ui/shell-layout": [
        "../../node_modules/@mokly/ui/dist/shell-layout/shell-layout.d.ts"
      ],
      "@mokly/ui/top-bar": [
        "../../node_modules/@mokly/ui/dist/top-bar/top-bar.d.ts"
      ],
      "@mokly/ui/workspace-layout": [
        "../../node_modules/@mokly/ui/dist/workspace-layout/workspace-layout.d.ts"
