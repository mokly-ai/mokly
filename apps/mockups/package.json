{
  "name": "@mokly-cloud/mockups",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "emails:build": "tsx --tsconfig tsconfig.runtime.json scripts/emails.ts",
    "emails:check": "tsx --tsconfig tsconfig.runtime.json scripts/emails.ts --check",
    "emails:test": "tsx --tsconfig tsconfig.runtime.json --test scripts/emails.test.ts",
    "typecheck": "tsc --noEmit",
    "mockups:build": "mokly build --config ../../mokly.config.json --strict --no-changes",
    "mockups:check": "mokly build --config ../../mokly.config.json --strict --no-changes --out .context/mockups-check",
    "mockups:typecheck": "tsc --noEmit",
    "mockups:serve": "mokly serve --config ../../mokly.config.json",
    "mockups:serve:test": "tsx --tsconfig tsconfig.runtime.json src/_tests_/serve-fixture.ts",
    "mockups:test": "npm run test:determinism && npm run test:policy && npm run test:browser",
    "test:determinism": "node scripts/check-determinism.mjs",
    "test:policy": "tsx --tsconfig tsconfig.runtime.json --import ./src/_tests_/register-web.mjs --test ../../docs/mockups/src/_tests_/*.test.ts",
    "test:browser": "npm run test:disk && npm run test:serve",
    "test:disk": "playwright test --config playwright.config.ts --tsconfig tsconfig.runtime.json",
    "test:serve": "playwright test --config playwright.serve.config.ts --tsconfig tsconfig.runtime.json"
  },
  "devDependencies": {
    "@firna/ui": "4.0.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@mokly/mokly": "0.22.0",
    "@mokly/ui": "0.22.0",
    "@mokly/viewer": "0.22.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "lucide-react": "0.577.0",
    "lucide-react-native": "0.577.0",
    "parse5": "8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.33.0",
    "react-native-reanimated": "4.3.4",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.8.3",
    "tsx": "4.23.15"
  }
}
