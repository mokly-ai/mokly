{
  "name": "@mokly-cloud/site",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "brand:build": "node scripts/brand-assets.mjs",
    "brand:check": "node scripts/brand-assets.mjs --check",
    "browser": "playwright test --config playwright.config.ts",
    "build": "npm run og && astro build --force && node --import tsx scripts/externalize-inline-scripts.ts && node scripts/index-search.mjs && npm run routes:check",
    "dev": "npm run og && astro dev",
    "lighthouse": "node --import tsx scripts/lighthouse.mjs",
    "links": "node --import tsx scripts/check-links.mjs",
    "og": "node --import tsx scripts/og.mjs",
    "preview": "astro preview",
    "routes:check": "node --import tsx scripts/generate-site-segments.ts --check",
    "routes:generate": "node --import tsx scripts/generate-site-segments.ts",
    "test": "npm run brand:check && tsx --test tests/*.test.ts",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@mokly-cloud/tokens": "0.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/react": "6.0.6",
    "@mokly/mokly": "0.23.0",
    "@mokly/viewer": "0.23.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sax": "1.2.7",
    "astro": "7.4.12",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "lightningcss": "1.33.0",
    "pagefind": "1.5.2",
    "parse5": "8.0.1",
    "prettier-plugin-astro": "1.0.0",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "srcset": "5.0.3",
    "tsx": "4.23.15",
    "wrangler": "4.164.0",
    "yaml": "2.9.1"
  }
}
