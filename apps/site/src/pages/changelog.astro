---
/**
 * The changelog, read as the design file's version history: Version
 * history beside the release frames, the page title as a selected text
 * layer, the release timeline, the note filter, then a full frame for each
 * of the six newest releases and the Earlier releases section of compact
 * frames for the older ones. The newest release is the one in view: its
 * frame is selected, its row is current and the playhead stands on it. The
 * changelog island runs the filter and follows the release in view. Every
 * release comes from the installed package's `CHANGELOG.md`; without a
 * release the page says that updates will appear here.
 */
import { readReleases } from "../changelog/releases.js";
import Earlier from "../components/changelog/Earlier.astro";
import { FULL_FRAMES } from "../components/changelog/facts.js";
import Filter from "../components/changelog/Filter.astro";
import History from "../components/changelog/History.astro";
import Intro from "../components/changelog/Intro.astro";
import Release from "../components/changelog/Release.astro";
import Timeline from "../components/changelog/Timeline.astro";
import Site from "../layouts/Site.astro";
import { PAGE_METADATA } from "../metadata.js";
import { SITE_PATHS } from "../navigation.js";

import "../styles/changelog.css";
import "../styles/changelog-history.css";
import "../styles/changelog-timeline.css";
import "../styles/changelog-filter.css";
import "../styles/changelog-notes.css";
import "../styles/changelog-upgrade.css";
import "../styles/changelog-release.css";
import "../styles/changelog-counts.css";
import "../styles/changelog-earlier.css";

const { description, title } = PAGE_METADATA[SITE_PATHS.changelog];
const releases = readReleases();
const current = releases[0]?.version;
---

<Site
  description={description}
  main="site-changelog"
  route={SITE_PATHS.changelog}
  title={title}
>
  <div class="site-changelog-body">
    <History current={current} releases={releases} />
    <div class="site-changelog-frames">
      <Intro lead={description} />
      {releases.length === 0 ? (
        <p class="site-changelog-empty">Updates will appear here</p>
      ) : (
        <>
          <Timeline current={current} releases={releases} />
          <Filter releases={releases} />
          <div class="site-releases">
            {releases.slice(0, FULL_FRAMES).map((release) => (
              <Release
                latest={release.version === current}
                release={release}
                selected={release.version === current}
              />
            ))}
          </div>
          <Earlier releases={releases.slice(FULL_FRAMES)} />
        </>
      )}
    </div>
  </div>
</Site>

<script src="../components/changelog/changelog-island.ts"></script>
