---
import Policy from "../components/Policy.astro";
import Site from "../layouts/Site.astro";
import { PAGE_METADATA } from "../metadata.js";
import { SITE_PATHS } from "../navigation.js";

const { description, title } = PAGE_METADATA[SITE_PATHS.complaints];
---

<Site
  description={description}
  main="site-policy"
  route={SITE_PATHS.complaints}
  title={title}
>
  <Policy id="complaints" />
</Site>
