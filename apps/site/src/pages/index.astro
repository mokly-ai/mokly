---
import Hero from "../components/home/Hero.astro";
import Workspace from "../components/home/Workspace.astro";
import Site from "../layouts/Site.astro";
import { PAGE_METADATA } from "../metadata.js";
import { SITE_PATHS } from "../navigation.js";

import "../styles/home.css";

const { description, title } = PAGE_METADATA[SITE_PATHS.home];
---

<Site description={description} route={SITE_PATHS.home} title={title}>
  <Hero />
  <Workspace />
</Site>
