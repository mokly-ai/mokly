---
/**
 * The page shell every route renders: the scheme island and the document
 * metadata, then on the dot-grid canvas the skip link, the header band, one
 * `main` landmark and the footer. The `main` landmark carries
 * `tabindex="-1"` so the skip link moves focus to it. A layout that places
 * its own landmark inside a wider composition, as the documentation does
 * beside its section tree, renders unwrapped and owns that element.
 *
 * The scheme island leads the head as a classic, blocking script, before
 * any stylesheet, so the reader's scheme applies before the first paint.
 * The layout emits its source, and the build moves it into a content-hashed
 * file under /_astro/, as it does every inline script.
 */
import { FEED_PATH } from "../changelog/feed.js";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import schemeIsland from "../components/scheme-island.js?raw";
import SkipLink from "../components/SkipLink.astro";
import {
  SOCIAL_IMAGE_DIRECTORY,
  availableSocialImages,
  canonicalUrl,
  socialImageUrl,
} from "../metadata.js";
import { settings } from "../settings.js";
import { SITE_TOKEN_CSS } from "../styles/token-styles.js";

import "../fonts/fonts.css";
import "../styles/base.css";
import "../styles/controls.css";
import "../styles/buttons.css";
import "../styles/canvas.css";
import "../styles/canvas-tags.css";
import "../styles/labels.css";
import "../styles/people.css";
import "../styles/chrome.css";
import "../styles/menu.css";
import "../styles/layout.css";
import "../styles/footer.css";
import "../styles/scheme.css";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly route: string;
  readonly indexed?: boolean;
  readonly main?: string;
  readonly wrapped?: boolean;
}

const {
  title,
  description,
  route,
  indexed = true,
  main = "site-main",
  wrapped = true,
} = Astro.props;

const canonical = canonicalUrl(route, settings.origin);
const image = socialImageUrl(
  route,
  settings.origin,
  availableSocialImages(SOCIAL_IMAGE_DIRECTORY),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={schemeIsland}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <style is:global set:html={SITE_TOKEN_CSS}></style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      href={FEED_PATH}
      rel="alternate"
      title="Mokly CLI releases"
      type="application/atom+xml"
    />
    {indexed && <link rel="canonical" href={canonical} />}
    {!indexed && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
  </head>
  <body class="site-root">
    <SkipLink />
    <Header route={route} />
    {wrapped ? (
      <main class={main} id="main" tabindex="-1">
        <slot />
      </main>
    ) : (
      <slot />
    )}
    <Footer route={route} />
  </body>
</html>
