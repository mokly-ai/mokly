---
/**
 * The avatar of one person or agent in the depicted design file: a person's
 * initial, or an agent's spark, on that person's colour and a ring of the
 * surface it sits on. `mokly` draws the Mokly mark at 18px on the surface,
 * for the answers that Mokly gives. It is 28px, and `small` draws the 22px
 * size of the status bar. A depiction: hidden from assistive technology.
 *
 * Use: `<Avatar person="maya" />`, or `<Avatar person="mokly" />`.
 */
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { PERSON, type Person } from "./people.js";

interface Props {
  readonly class?: string;
  readonly person: Person | "mokly";
  readonly small?: boolean;
}

const { class: className, person, small = false } = Astro.props;
const facts = person === "mokly" ? undefined : PERSON[person];
---

<span
  aria-hidden="true"
  class:list={[
    "site-avatar",
    `site-avatar--${person}`,
    small && "site-avatar--small",
    className,
  ]}
>
  {facts === undefined ? (
    <Mark size={18} />
  ) : facts.agent ? (
    <Icon name="spark" size={small ? 11 : 13} />
  ) : (
    facts.name.slice(0, 1)
  )}
</span>
