---
/**
 * The Mokly mark beside the lowercase Geist wordmark with its signal period.
 * The mark is the selected layer of a design file: an ink outline frame
 * behind a signal front layer that carries two short rules, parted from the
 * frame by a halo of the surface. Together they link Home from every page
 * with the accessible name "Mokly home", and they mark the current page on
 * the home itself.
 */
import { SITE_PATHS, currentPage } from "../navigation.js";

interface Props {
  readonly route: string;
  readonly size?: number;
}

const { route, size = 30 } = Astro.props;
---

<a
  aria-current={currentPage(route, SITE_PATHS.home)}
  aria-label="Mokly home"
  class="site-brand"
  href={SITE_PATHS.home}
>
  <svg
    aria-hidden="true"
    class="site-mark"
    focusable="false"
    height={size}
    viewBox="0 0 32 32"
    width={size}
  >
    <rect
      class="site-mark-back"
      height="19.8"
      rx="4.6"
      width="18.8"
      x="3.6"
      y="3.6"
    ></rect>
    <rect
      class="site-mark-front"
      height="21"
      rx="4.8"
      width="20"
      x="9"
      y="8"
    ></rect>
    <path class="site-mark-rules" d="M14 15h10M14 20h7"></path>
  </svg>
  <span class="site-brand-word">
    mokly<span class="site-brand-dot">.</span>
  </span>
</a>
