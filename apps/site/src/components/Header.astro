---
/**
 * The shared header: the tool bar of the depicted design file, a sticky
 * band on every page. It holds the brand; the file title `mokly.ai — {page}`
 * with its `main` branch chip; the people in the file; the navigation; Get
 * started; and the menu control. The file title and the people are
 * depictions, hidden from assistive technology. Below the breakpoint the bar
 * keeps the brand, Get started and the menu control, and the menu lists the
 * destinations.
 */
import {
  EXTERNAL_LINKS,
  GET_STARTED_PATH,
  SITE_PATHS,
  currentPage,
} from "../navigation.js";

import Brand from "./Brand.astro";
import Button from "./Button.astro";
import Chip from "./Chip.astro";
import Menu from "./Menu.astro";
import Presence from "./Presence.astro";
import { pageName } from "./page-name.js";

interface Props {
  readonly route: string;
}

const { route } = Astro.props;
---

<div class="site-band">
  <header class="site-header">
    <div class="site-header-start">
      <Brand route={route} />
    </div>
    <div aria-hidden="true" class="site-header-title">
      <span class="site-file">
        <span class="site-file-team">mokly.ai</span>
        <span class="site-file-dash">—</span>
        <span class="site-file-name">{pageName(route)}</span>
      </span>
      <Chip icon="branch" mono>
        main
      </Chip>
    </div>
    <div class="site-header-end">
      {/* status: "ahead" (Claude, Codex) */}
      <Presence class="site-header-presence" />
      <nav aria-label="Main" class="site-nav">
        <a
          aria-current={currentPage(route, SITE_PATHS.docs)}
          class="site-nav-link"
          href={SITE_PATHS.docs}
        >
          Docs
        </a>
        <a
          aria-current={currentPage(route, SITE_PATHS.changelog)}
          class="site-nav-link"
          href={SITE_PATHS.changelog}
        >
          Changelog
        </a>
        <a
          aria-current={currentPage(route, SITE_PATHS.pricing)}
          class="site-nav-link"
          href={SITE_PATHS.pricing}
        >
          Pricing
        </a>
        <a class="site-nav-link" href={EXTERNAL_LINKS.github}>
          GitHub
        </a>
      </nav>
      <Button
        arrow
        class="site-header-cta"
        href={GET_STARTED_PATH}
        kind="primary"
      >
        Get started
      </Button>
      <Menu route={route} />
    </div>
  </header>
</div>
