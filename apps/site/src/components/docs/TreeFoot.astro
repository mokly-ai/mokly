---
/**
 * The foot of the section tree: the Changelog row, a panel row that links
 * the changelog, in the Layers panel's foot and in the tree sheet.
 *
 * Use: `<TreeFoot />`, or `<TreeFoot slot="foot" />` in a panel.
 */
import { SITE_PATHS } from "../../navigation.js";
import Icon from "../Icon.astro";
import PanelRow from "../PanelRow.astro";
---

<div class="site-doc-tree-foot">
  <PanelRow class="site-doc-link" href={SITE_PATHS.changelog} icon="history">
    Changelog
    <Icon name="arrowRight" size={14} slot="trailing" />
  </PanelRow>
</div>
