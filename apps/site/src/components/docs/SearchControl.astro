---
/**
 * A documentation search control, which opens the search dialog as ⌘K,
 * Ctrl K and `/` do. The full control in the Layers panel is shaped like a
 * field and shows its key hint; the compact one is the sub-bar's 44px icon
 * control. Both are named Search docs. The page draws them, and the search
 * island binds them and sets the key hint to ⌘K on Apple platforms, so
 * without script neither shows.
 *
 * Use: `<SearchControl />` or `<SearchControl compact />`.
 */
import Icon from "../Icon.astro";

interface Props {
  readonly compact?: boolean;
}

const { compact = false } = Astro.props;
---

<button
  aria-controls="site-search"
  aria-haspopup="dialog"
  aria-keyshortcuts="Control+K Meta+K /"
  class="site-search"
  type="button"
>
  <Icon name="search" size={compact ? 18 : 15} />
  {compact ? (
    <span class="site-visually-hidden">Search docs</span>
  ) : (
    <>
      <span class="site-search-label">Search docs</span>
      <kbd aria-hidden="true" class="site-search-key">
        Ctrl K
      </kbd>
    </>
  )}
</button>
