---
/**
 * The Layers content beside the page frame from 1024px: a navigation
 * landmark named Documentation that holds the search control and the
 * published CLI version at its top, every section with its pages, and the
 * Changelog row at its foot. Its tree keeps its scroll offset across docs
 * pages in the tab, through the tree scroll island.
 *
 * Use: `<Layers route={route} />` inside the workspace's Layers column.
 */
import SearchControl from "./SearchControl.astro";
import TreeFoot from "./TreeFoot.astro";
import TreeSections from "./TreeSections.astro";
import VersionRow from "./VersionRow.astro";

interface Props {
  readonly route: string;
}

const { route } = Astro.props;
---

<nav aria-label="Documentation" class="site-doc-tree">
  <div class="site-docs-layers-top">
    <SearchControl />
    <VersionRow />
  </div>
  <TreeSections route={route} />
  <TreeFoot />
</nav>

<script src="./tree-scroll.ts"></script>
