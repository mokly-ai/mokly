---
/**
 * The catalogue column of the depicted Mokly viewer in the home's Browse
 * frame: the All and Changes filter with All chosen and the count of the
 * changed and added entries, then the Specs and Components sections of the
 * acme/storefront catalogue, whose rows `viewer-tree.ts` holds. A phone
 * folds the column over the open screen. A depiction: the viewer that
 * holds it is hidden from assistive technology, and its rows take no focus.
 *
 * Use: `<ViewerTree />` in `Viewer.astro`. The rules are in
 * `src/styles/home-viewer-tree.css`.
 */
import Icon from "../Icon.astro";

import { CHANGE_COUNT, TREE_SECTIONS } from "./viewer-tree.js";

import "../../styles/home-viewer-tree.css";
---

<div class="site-tree">
  <span class="site-filter">
    <span class="site-filter-option site-filter-option--current">All</span>
    <span class="site-filter-option">
      Changes <span class="site-filter-count">{CHANGE_COUNT}</span>
    </span>
  </span>
  <div class="site-tree-scroll">
    {TREE_SECTIONS.map((section) => (
      <div class="site-tree-section">
        <p class="site-tree-section-head">{section.title}</p>
        {section.rows.map((row) => (
          <span
            class:list={[
              "site-row",
              row.open && "site-row--group",
              row.current && "site-row--current",
            ]}
            data-site-depth={row.depth}
          >
            {row.open && (
              <span class="site-tree-chevron">
                <Icon name="chevronDown" size={12} />
              </span>
            )}
            {row.icon !== undefined && (
              <span class="site-row-ico">
                <Icon name={row.icon} size={13} />
              </span>
            )}
            <span class="site-row-label">{row.label}</span>
            {row.change !== undefined && (
              <span class={`site-home-dot site-home-dot--${row.change}`} />
            )}
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
