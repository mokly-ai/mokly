---
/**
 * The logo of the depicted acme/storefront app: a coffee bean in the
 * terracotta hue and the name in Instrument Serif. A depiction: plain text
 * and a hidden drawing.
 *
 * Use: `<AcmeLogo />`.
 */
---

<span class="site-acme-logo">
  <svg aria-hidden="true" focusable="false" viewBox="0 0 22 22">
    <ellipse
      class="site-acme-logo-bean"
      cx="11"
      cy="11"
      rx="7.4"
      ry="9.6"
      transform="rotate(32 11 11)"
    ></ellipse>
    <path
      class="site-acme-logo-crease"
      d="M8.2 5.6c3.8 2.4 1.9 8.4 5.6 10.8"
    ></path>
  </svg>
  acme
</span>
