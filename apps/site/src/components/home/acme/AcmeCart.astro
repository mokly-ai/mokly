---
/**
 * The bag icon of the depicted acme/storefront app with its count of two
 * items on a terracotta dot.
 *
 * Use: `<AcmeCart />`, in a screen's navigation.
 */
import AcmeIcon from "./AcmeIcon.astro";
---

<span class="site-acme-cart">
  <AcmeIcon name="bag" />
  <i>
    <span>2</span>
  </i>
</span>
