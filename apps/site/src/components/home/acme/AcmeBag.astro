---
/**
 * A bag of coffee of the depicted acme/storefront app, in one of the four
 * roasts. The roast's tone class gives the current colour, and every part
 * of the bag mixes its own fill from it in the stylesheet. A hidden drawing.
 *
 * - `roast`: `guji`, `huila`, `nyeri` or `decaf`.
 * - `class`: the place's class, such as `site-acme-welcome-bag`.
 *
 * Use: `<AcmeBag roast="guji" />`.
 */
import { roastTone, type AcmeRoast } from "./acme-bag.js";

interface Props {
  readonly class?: string;
  readonly roast: AcmeRoast;
}

const { class: className, roast } = Astro.props;
---

<svg
  aria-hidden="true"
  class:list={["site-acme-bag", roastTone(roast), className]}
  focusable="false"
  viewBox="0 0 64 84"
>
  <ellipse
    class="site-acme-bag-shadow"
    cx="32"
    cy="80.5"
    rx="23"
    ry="2.6"
  ></ellipse>
  <path
    class="site-acme-bag-body"
    d="M13 14h38l4 60a4 4 0 0 1-4 4H13a4 4 0 0 1-4-4z"
  ></path>
  <path class="site-acme-bag-side" d="M44 14h7l4 60a4 4 0 0 1-4 4h-6z"></path>
  <path
    class="site-acme-bag-shine"
    d="M13 14h5l-1.2 64H13a4 4 0 0 1-4-4z"
  ></path>
  <rect
    class="site-acme-bag-top"
    height="10"
    rx="1.6"
    width="39"
    x="12.5"
    y="6"
  ></rect>
  <path class="site-acme-bag-fold" d="M15 9.4h34M15 12.4h34"></path>
  <rect
    class="site-acme-bag-label"
    height="31"
    rx="3"
    width="28"
    x="18"
    y="31"
  ></rect>
  <circle class="site-acme-bag-mark" cx="32" cy="42" r="5.6"></circle>
  <path class="site-acme-bag-mark" d="M29.4 44.3c1.9-1.1 3.2-3.1 5-4.5"></path>
  <rect
    class="site-acme-bag-line"
    height="2.3"
    rx="1.15"
    width="18"
    x="23"
    y="52"
  ></rect>
  <rect
    class="site-acme-bag-line site-acme-bag-line--soft"
    height="1.8"
    rx=".9"
    width="12"
    x="26"
    y="56.4"
  ></rect>
</svg>
