---
/**
 * An artboard of the depicted acme/storefront app: one screen at its native
 * size, scaled into a framed box and labelled with its path, its device
 * and, for a dark screen, the moon. The spread and the feature frames place
 * artboards: the place's rule sets the box size, the screen's scale and,
 * on a canvas, the artboard's spot. The label and the
 * screen are depictions; the place that draws an artboard hides it from
 * assistive technology.
 *
 * - `device`: `phone` or `desktop`, which the label's icon shows.
 * - `name`: the screen's path, such as `checkout/payment`.
 * - `dark`: the label adds the moon, for a dark screen.
 * - `live`: the label adds the Live tag, for a live session.
 * - `class`: the place's class.
 *
 * Use: `<Artboard device="phone" name="pricing"><AcmePricingPhone /><CardSelection slot="overlay" tall /></Artboard>`.
 * The screen is the slot; a mark over the artboard, such as a selection,
 * goes in the `overlay` slot. The rules are in `src/styles/home-board.css`.
 */
import Icon from "../Icon.astro";

import "../../styles/home-board.css";

interface Props {
  readonly class?: string;
  readonly dark?: boolean | undefined;
  readonly device: "desktop" | "phone";
  readonly live?: boolean;
  readonly name: string;
}

const {
  class: className,
  dark = false,
  device,
  live = false,
  name,
} = Astro.props;
---

<figure
  class:list={["site-home-board", `site-home-board--${device}`, className]}
>
  <figcaption class="site-home-board-label">
    <Icon name={device} size={12} />
    {name}
    {dark && <Icon name="moon" size={12} />}
    {/* status: "ahead" (agent sessions) */}
    {live && (
      <span class="site-home-board-live">
        <span class="site-home-live-dot" />
        Live
      </span>
    )}
  </figcaption>
  <div class="site-home-board-frame">
    <div class="site-home-board-screen">
      <slot />
    </div>
  </div>
  <slot name="overlay" />
</figure>
