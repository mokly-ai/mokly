---
/**
 * The home hero: the heading, the lead, and Get started and Download for
 * Mac. The copy is the approved home copy in docs/protocol/cloud/site-copy.md,
 * held in src/home.ts so the page description and social cards repeat it.
 * The `hero` id is the target of the Specs panel's Hero row.
 */
import { HOME_HERO } from "../../home.js";
import Actions from "../Actions.astro";
---

<section class="site-hero" id="hero">
  <h1>{HOME_HERO.heading}</h1>
  <p class="site-hero-lead">{HOME_HERO.lead}</p>
  <Actions secondary="download" />
</section>
