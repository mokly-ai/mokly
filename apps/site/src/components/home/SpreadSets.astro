---
/**
 * The component sets in the spread's Components box: Button, PriceCard,
 * Badge, Avatar, Input and Toast of the depicted acme/storefront app, each a
 * labelled box that draws the component's variants at half size. The sets
 * stand in two columns that stack each set under the one before it, so a set
 * never covers its neighbour, whatever its size. Codex has the Button set
 * selected. A depiction: the spread hides it from assistive technology.
 *
 * Use: `<SpreadSets />`, in the Components box of `Spread.astro`. The rules
 * are in `src/styles/home-spread.css`.
 */
import Icon from "../Icon.astro";
import Selection from "../Selection.astro";

import type { AcmeSetName } from "./acme/acme-sets.js";
import AcmeSet from "./acme/AcmeSet.astro";

/** One component set: its label and its variants. */
interface SpreadSet {
  readonly label: string;
  readonly name: AcmeSetName;
}

/** The sets of each column, from the top. */
const COLUMNS: readonly (readonly SpreadSet[])[] = [
  [
    { label: "Button", name: "button" },
    { label: "PriceCard", name: "priceCard" },
    { label: "Toast", name: "toast" },
  ],
  [
    { label: "Badge", name: "badge" },
    { label: "Avatar", name: "avatar" },
    { label: "Input", name: "input" },
  ],
];
---

<div class="site-home-sets">
  {COLUMNS.map((column) => (
    <div class="site-home-sets-column">
      {column.map((set) => (
        <div class="site-home-set">
          <span class="site-home-set-label">
            <Icon name="component" size={12} />
            {set.label}
          </span>
          <div class="site-home-set-box">
            <div class="site-home-set-inner">
              <AcmeSet name={set.name} />
            </div>
          </div>
          {/* status: "ahead" (Codex) */}
          {set.name === "button" && (
            <Selection
              class="site-home-set-peer"
              handles="none"
              person="codex"
            />
          )}
        </div>
      ))}
    </div>
  ))}
</div>
