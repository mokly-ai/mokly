---
/**
 * The home's action pair: the filled Get started with its arrow, which opens
 * the Install guide, then a secondary action. `secondary` names it:
 * `download` is Download for Mac, which opens the desktop app's releases,
 * for the hero; `github` is View on GitHub, which opens the open-source
 * repository, for the open foundation. Each icon is decorative, so each
 * accessible name is the label.
 *
 * Use: `<Actions secondary="download" />`. The rules are in
 * `src/styles/buttons.css` and `src/styles/controls.css`.
 */
import { EXTERNAL_LINKS, GET_STARTED_PATH } from "../navigation.js";

import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  readonly secondary: "download" | "github";
}

const { secondary } = Astro.props;
---

<div class="site-actions">
  <Button arrow href={GET_STARTED_PATH} kind="primary">
    Get started
  </Button>
  {secondary === "download" ? (
    <Button href={EXTERNAL_LINKS.desktopReleases} kind="secondary">
      <Icon name="download" />
      Download for Mac
    </Button>
  ) : (
    <Button href={EXTERNAL_LINKS.github} kind="secondary">
      <Icon name="github" size={18} />
      View on GitHub
    </Button>
  )}
</div>
