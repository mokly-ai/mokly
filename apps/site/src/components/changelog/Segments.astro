---
/**
 * The text of a release note, an item or an upgrade note, from the typed
 * segments of the changelog parser, so the page never inserts raw Markdown
 * or unchecked markup: its text, its code spans, its bold and its links.
 *
 * Use: `<span class="site-release-note-text"><Segments segments={note.text} /></span>`.
 */
import type { NoteSegment } from "../../changelog/notes.js";

interface Props {
  readonly segments: readonly NoteSegment[];
}

const { segments } = Astro.props;
---

{segments.map((segment) =>
  segment.kind === "link" ? (
    <a href={segment.href}>{segment.text}</a>
  ) : segment.kind === "code" ? (
    <code>{segment.value}</code>
  ) : segment.kind === "strong" ? (
    <strong>{segment.value}</strong>
  ) : (
    <Fragment>{segment.value}</Fragment>
  ),
)}
