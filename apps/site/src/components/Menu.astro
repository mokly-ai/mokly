---
/**
 * The mobile header's menu: the control at the trailing edge of the tool bar
 * and the sheet it opens. The sheet is a modal dialog that drops in below
 * the bar over a dimmed page, so the page is inert until the reader closes
 * it. Its Close menu control takes the menu control's place in the bar's
 * top-right corner. Above the breakpoint the tool bar lists the same
 * destinations and the control is not drawn.
 */
import {
  EXTERNAL_LINKS,
  GET_STARTED_PATH,
  SITE_PATHS,
  type SitePath,
  currentPage,
} from "../navigation.js";

import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  readonly route: string;
}

const { route } = Astro.props;

/** The site routes the menu lists, in the header's reading order. */
const pages: ReadonlyArray<readonly [SitePath, string]> = [
  [SITE_PATHS.docs, "Docs"],
  [SITE_PATHS.changelog, "Changelog"],
];
---

<button
  aria-controls="site-menu"
  aria-expanded="false"
  aria-haspopup="dialog"
  aria-label="Menu"
  class="site-menu-button"
  type="button"
>
  <Icon name="menu" size={20} />
</button>
<dialog aria-label="Menu" class="site-menu" closedby="any" id="site-menu">
  <div class="site-menu-panel">
    <div class="site-menu-head">
      <button aria-label="Close menu" class="site-menu-close" type="button">
        <Icon name="close" size={20} />
      </button>
    </div>
    <nav aria-label="Main" class="site-menu-nav">
      {pages.map(([path, label]) => (
        <a
          aria-current={currentPage(route, path)}
          class="site-menu-link"
          href={path}
        >
          {label}
        </a>
      ))}
      <a class="site-menu-link" href={EXTERNAL_LINKS.github}>
        GitHub
      </a>
    </nav>
    <div class="site-menu-actions">
      <Button arrow href={GET_STARTED_PATH} kind="primary">
        Get started
      </Button>
    </div>
  </div>
</dialog>

<script src="./menu-dialog.ts"></script>
