---
/**
 * The design file's status bar, on the canvas under the footer frame: the
 * file `mokly.ai — {page}` with the frame icon, the people in the file and
 * the zoom pill. A depiction: hidden from assistive technology, and nothing
 * in it takes focus. Below the breakpoint the file leaves the bar.
 *
 * On the home the zoom pill is a control, so the bar stays readable and each
 * depicted part hides itself. The bar also draws `home/ZoomControl.astro`
 * after the depicted pill, hidden until the home zoom island swaps it in.
 *
 * Use: `<StatusBar route={route} />`, with the rendered route.
 */
import { SITE_PATHS } from "../navigation.js";

import ZoomControl from "./home/ZoomControl.astro";
import { ZOOM_MARKS } from "./home/zoom-marks.js";
import Icon from "./Icon.astro";
import { pageName } from "./page-name.js";
import { PEOPLE } from "./people.js";
import Presence from "./Presence.astro";

interface Props {
  readonly route: string;
}

const { route } = Astro.props;

/** Whether the bar holds the home's zoom control. */
const home = route === SITE_PATHS.home;

/** The bar's `aria-hidden`, and that of each depicted part on the home. */
const bar = home ? undefined : "true";
const part = home ? "true" : undefined;

/** The mark of the depicted pill that the home zoom island replaces. */
const depiction = home ? ZOOM_MARKS.depiction : {};
---

<div aria-hidden={bar} class="site-statusbar">
  <span aria-hidden={part} class="site-statusbar-item site-statusbar-file">
    <Icon name="frame" size={14} />
    mokly.ai — {pageName(route)}
  </span>
  {/* status: "ahead" (Claude, Codex) */}
  <span aria-hidden={part} class="site-statusbar-item">
    <Presence small />
    {PEOPLE.length} in this file
  </span>
  <span aria-hidden={part} class="site-statusbar-zoom" {...depiction}>
    <span>−</span>
    100%
    <span>+</span>
  </span>
  {home && <ZoomControl />}
</div>
