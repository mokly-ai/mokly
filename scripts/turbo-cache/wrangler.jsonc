{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mokly-turbo-cache",
  "main": "worker.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "mokly-turbo-cache",
      "remote": false,
    },
  ],
  "vars": { "TURBO_CACHE_TEAM": "mokly" },
  "observability": { "enabled": true },
}
